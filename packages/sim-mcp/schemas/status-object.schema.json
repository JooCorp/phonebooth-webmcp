{
  "title": "StatusObject",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "callRequestId",
    "revision",
    "status",
    "meaning",
    "sayToOwner",
    "next",
    "request",
    "calleeAlias",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "callRequestId": {
      "type": "string",
      "pattern": "^cr_[a-z0-9]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "thinking",
        "needs_answers",
        "queued",
        "calling",
        "done",
        "not_placed",
        "cancelled"
      ]
    },
    "meaning": {
      "type": "string",
      "minLength": 1
    },
    "sayToOwner": {
      "type": "string",
      "minLength": 1
    },
    "next": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/nextHint"
      }
    },
    "checkAfterSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "request": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "calleeAlias": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "callNow": {
      "const": true
    },
    "retryNow": {
      "const": true
    },
    "attemptSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count"],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "questionSetId": {
      "type": "string",
      "pattern": "^qs_[a-z0-9]+$"
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/question"
      }
    },
    "canContinueWithoutOptional": {
      "type": "boolean"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "notBefore": {
          "type": "string",
          "format": "date-time"
        },
        "notAfter": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "live": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "seconds"
      ],
      "properties": {
        "phase": {
          "enum": [
            "dialing",
            "ringing",
            "connected",
            "on_hold",
            "ending"
          ]
        },
        "seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectiveSucceeded",
        "summary",
        "facts",
        "endedBecause",
        "durationSeconds",
        "untrustedContent"
      ],
      "properties": {
        "objectiveSucceeded": {
          "type": ["boolean", "null"]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "value"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "endedBecause": {
          "type": "string",
          "minLength": 1
        },
        "durationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "untrustedContent": {
          "const": true
        },
        "presentation": {
          "$ref": "#/definitions/callResultPresentation"
        }
      }
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "text"
      ],
      "properties": {
        "code": {
          "enum": [
            "outside_calling_hours",
            "unsupported_country",
            "rate_limited",
            "do_not_call",
            "deadline_passed",
            "not_answered",
            "engine_unavailable"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "retryAfter": {
          "type": "string",
          "format": "date-time"
        },
        "retryAfterText": {
          "type": "string"
        }
      }
    },
    "reportBack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "status",
        "tool",
        "once"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "none",
            "waiting",
            "queued",
            "calling",
            "done"
          ]
        },
        "tool": {
          "const": "request_report_back_call"
        },
        "once": {
          "const": true
        }
      }
    },
    "whisper": {
      "type": "string",
      "minLength": 1
    },
    "changed": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs_answers"
          }
        }
      },
      "then": {
        "required": [
          "questionSetId",
          "questions",
          "canContinueWithoutOptional"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "queued"
          }
        }
      },
      "then": {
        "required": [
          "window"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "calling"
          }
        }
      },
      "then": {
        "required": [
          "live"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "done"
          }
        }
      },
      "then": {
        "required": [
          "result"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "not_placed"
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "done",
              "not_placed",
              "cancelled"
            ]
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "checkAfterSeconds"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "thinking",
              "queued",
              "calling",
              "done",
              "not_placed",
              "cancelled"
            ]
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "questions"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "not": {
              "const": "calling"
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "live"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "not": {
              "const": "done"
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "result"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "needs_answers",
              "not_placed",
              "cancelled"
            ]
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "whisper"
          ]
        }
      }
    }
  ],
  "definitions": {
    "nextHint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "args"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "args": {
          "type": "object"
        },
        "after": {
          "const": "checkAfterSeconds"
        }
      }
    },
    "callResultPresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion"
      ],
      "properties": {
        "schemaVersion": {
          "const": "call-result-presentation-v1"
        },
        "outcomeLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "sections": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/definitions/callResultSection"
          }
        },
        "recording": {
          "$ref": "#/definitions/callResultRecording"
        },
        "transcript": {
          "$ref": "#/definitions/callResultTranscript"
        },
        "footerNote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "callResultSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/callResultElementId"
        },
        "state": {
          "$ref": "#/definitions/callResultContentState"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "fields": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "$ref": "#/definitions/callResultField"
          }
        },
        "notes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "items"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "items": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          }
        }
      }
    },
    "callResultField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "value"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/callResultElementId"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "callResultRecording": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "downloadUrl",
        "filename"
      ],
      "properties": {
        "state": {
          "$ref": "#/definitions/callResultContentState"
        },
        "downloadUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "duration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "callResultTranscript": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "lines"
      ],
      "properties": {
        "state": {
          "$ref": "#/definitions/callResultContentState"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "duration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "disclosure": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "lines": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "speaker",
              "text"
            ],
            "properties": {
              "id": {
                "$ref": "#/definitions/callResultElementId"
              },
              "speaker": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "time": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          }
        }
      }
    },
    "callResultContentState": {
      "enum": [
        "empty",
        "partial",
        "filled"
      ]
    },
    "callResultElementId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "required",
        "input"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^q_[a-z0-9_]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "text",
            "phone",
            "address",
            "date",
            "choice"
          ]
        },
        "sensitivity": {
          "enum": [
            "public",
            "sensitive",
            "restricted"
          ]
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "text",
                "single_choice"
              ]
            },
            "placeholder": {
              "type": "string"
            },
            "multiline": {
              "type": "boolean"
            },
            "choices": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "label"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "followup": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "const": "text"
                      },
                      "placeholder": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "single_choice"
                  }
                }
              },
              "then": {
                "required": [
                  "choices"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "placeholder"
                      ]
                    },
                    {
                      "required": [
                        "multiline"
                      ]
                    }
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "text"
                  }
                }
              },
              "then": {
                "not": {
                  "required": [
                    "choices"
                  ]
                }
              }
            }
          ]
        },
        "whyWeAsk": {
          "type": "string"
        },
        "example": {
          "type": "string"
        },
        "prefillHint": {
          "type": "string"
        }
      }
    }
  }
}
