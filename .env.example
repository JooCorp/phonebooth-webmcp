# Optional: the hosted JooVoice MCP endpoint used outside simulation mode.
VITE_HOSTED_MCP_URL=http://localhost:4323/mcp

# JooVoice identity API used to create and wait for device-login codes.
VITE_JOOVOICE_API_URL=http://localhost:2010

# Full-page transition indicators wait briefly to avoid flashing on fast navigation.
VITE_ROUTE_TRANSITION_LOADER_DELAY_SECONDS=0.5
